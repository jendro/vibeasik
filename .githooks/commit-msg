#!/usr/bin/env bash
# Tolak pesan commit di luar Conventional Commits.
# Format: <type>(<scope>)?!?: <subjek>   — type: feat fix docs refactor perf test build ci chore revert
msg_file="$1"
first=$(grep -v '^#' "$msg_file" | head -n1)
case "$first" in Merge\ *|Revert\ *|fixup!*|squash!*) exit 0;; esac
re='^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! [[ "$first" =~ $re ]]; then
  echo "✖ Pesan commit harus Conventional Commits, mis. 'feat(scanner): deteksi stack Bun'" >&2
  echo "  Didapat: $first" >&2
  exit 1
fi
if [ ${#first} -gt 72 ]; then
  echo "✖ Subjek commit maksimal 72 karakter (sekarang ${#first})." >&2
  exit 1
fi
case "$first" in *": wip"*|*": update"|*": updates"|*": fix"|*": misc"*)
  echo "✖ Subjek terlalu umum ('$first'). Tulis apa yang berubah." >&2; exit 1;; esac
exit 0
