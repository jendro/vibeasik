    "generated_script": "#!/usr/bin/env bash\n# vibeasik Workspace Reorganization Script\n# Dibuat otomatis pada: \u003cT\u003e\n# Target Folder: <TMP>/ws\n\nset -e\n\necho '=== Memulai Reorganisasi Folder Proyek vibeasik ==='\nmkdir -p \"<TMP>/ws\"\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/inplace -\u003e <TMP>/ws/dup\n# Alasan: Target folder sudah ada di komputer: <TMP>/ws/dup\n\n# Pindahkan: --- ()\nif [ -d \"<TMP>/src/solo2\" ]; then\n  if [ ! -d \"<TMP>/ws/proj-<UNIX>\" ]; then\n    mkdir -p \"<TMP>/ws\"\n    mv \"<TMP>/src/solo2\" \"<TMP>/ws/proj-<UNIX>\"\n    echo ' [OK] Berhasil memindahkan: proj-<UNIX>'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/proj-<UNIX>'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/solo2'\nfi\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/nope -\u003e <TMP>/ws/solomissing\n# Alasan: Folder sumber tidak ditemukan di komputer: <TMP>/src/nope\n\n# Pindahkan: Solo ()\nif [ -d \"<TMP>/src/solo\" ]; then\n  if [ ! -d \"<TMP>/ws/solo\" ]; then\n    mkdir -p \"<TMP>/ws\"\n    mv \"<TMP>/src/solo\" \"<TMP>/ws/solo\"\n    echo ' [OK] Berhasil memindahkan: solo'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/solo'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/solo'\nfi\n\n# Pindahkan: ShopBackend (api)\nif [ -d \"<TMP>/src/be\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/backend\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/be\" \"<TMP>/ws/shop/backend\"\n    echo ' [OK] Berhasil memindahkan: shop/backend'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/backend'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/be'\nfi\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/fe -\u003e <TMP>/ws/shop/frontend\n# Alasan: Target folder sudah ada di komputer: <TMP>/ws/shop/frontend\n\n# Pindahkan: ShopBackend (adm)\nif [ -d \"<TMP>/src/adm\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/frontend-admin\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/adm\" \"<TMP>/ws/shop/frontend-admin\"\n    echo ' [OK] Berhasil memindahkan: shop/frontend-admin'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/frontend-admin'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/adm'\nfi\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/mob -\u003e <TMP>/ws/shop/mobile\n# Alasan: Target folder sudah ada di komputer: <TMP>/ws/shop/mobile\n\n# Pindahkan: ShopBackend (cli)\nif [ -d \"<TMP>/src/cli\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/cli\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/cli\" \"<TMP>/ws/shop/cli\"\n    echo ' [OK] Berhasil memindahkan: shop/cli'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/cli'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/cli'\nfi\n\n# Pindahkan: ShopBackend (wrk)\nif [ -d \"<TMP>/src/wrk\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/worker\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/wrk\" \"<TMP>/ws/shop/worker\"\n    echo ' [OK] Berhasil memindahkan: shop/worker'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/worker'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/wrk'\nfi\n\n# Pindahkan: ShopBackend (doc)\nif [ -d \"<TMP>/src/doc\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/docs\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/doc\" \"<TMP>/ws/shop/docs\"\n    echo ' [OK] Berhasil memindahkan: shop/docs'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/docs'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/doc'\nfi\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/missing -\u003e <TMP>/ws/shop/backend\n# Alasan: Folder sumber tidak ditemukan di komputer: <TMP>/src/missing\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/x1 -\u003e <TMP>/ws/shop/frontend\n# Alasan: Target folder sudah ada di komputer: <TMP>/ws/shop/frontend\n\n# [DILEWATI KARENA KONFLIK] <TMP>/src/x2 -\u003e <TMP>/ws/shop/mobile\n# Alasan: Target folder sudah ada di komputer: <TMP>/ws/shop/mobile\n\n# Pindahkan: ShopBackend (Other Thing)\nif [ -d \"<TMP>/src/x3\" ]; then\n  if [ ! -d \"<TMP>/ws/shop/other-thing\" ]; then\n    mkdir -p \"<TMP>/ws/shop\"\n    mv \"<TMP>/src/x3\" \"<TMP>/ws/shop/other-thing\"\n    echo ' [OK] Berhasil memindahkan: shop/other-thing'\n  else\n    echo ' [SKIP] Target sudah ada: <TMP>/ws/shop/other-thing'\n  fi\nelse\n  echo ' [SKIP] Sumber tidak ditemukan: <TMP>/src/x3'\nfi\n\necho '=== Reorganisasi Selesai! Silakan sinkronkan path di vibeasik. ==='\n",
