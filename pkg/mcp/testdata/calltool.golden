    "impact_score": 44,
    "impact_level": "low",
    "impact_summary": "Meningkatkan Kemudahan Dirawat AI (3), Kejelasan untuk AI (2), Keandalan (2)",
    "impact_source": "heuristic",
    "created_at": "<t>",
